# ============================================
# Sports Probability Engine - Environment
# ============================================
# Copie este arquivo para `.env.local` no desenvolvimento.
# Na Vercel, cadastre as mesmas variáveis em Project Settings > Environment Variables.
# NUNCA coloque valores secretos reais neste arquivo.

# --------------------------------------------
# Supabase - cliente/publico
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --------------------------------------------
# Supabase - somente servidor
# --------------------------------------------
# Nunca use NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# API esportiva - API-Football
# --------------------------------------------
SPORTS_API_KEY=
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
SPORTS_API_PROVIDER=api-football

# --------------------------------------------
# Aplicacao
# --------------------------------------------
APP_TIMEZONE=America/Sao_Paulo

# --------------------------------------------
# Rotas internas / Vercel Cron
# --------------------------------------------
# Gere um valor longo e aleatorio para proteger rotas de sincronizacao.
CRON_SECRET=
