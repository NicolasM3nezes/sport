# Supabase - valores públicos usados pelo frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente backend, caso sejam criadas rotas administrativas server-side
SUPABASE_SERVICE_ROLE_KEY=

# APIfootball.com V3
# A API de produção também está armazenada no Supabase Vault como sports_api_key.
SPORTS_API_KEY=
SPORTS_API_BASE_URL=https://apiv3.apifootball.com
SPORTS_API_PROVIDER=apifootball

# Fuso principal da aplicação
APP_TIMEZONE=America/Sao_Paulo

# Opcional para endpoints server-side protegidos
CRON_SECRET=
